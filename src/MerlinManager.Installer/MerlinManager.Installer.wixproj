<Project Sdk="WixToolset.Sdk/4.0.4">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <OutputName>MerlinManager</OutputName>
    <PublishOutputDir>..\MerlinManager\bin\$(Configuration)\publish\</PublishOutputDir>
    <CabinetFileCount>1</CabinetFileCount>
    <CabinetCompressionLevel>high</CabinetCompressionLevel>
    <CabinetFileName>internal.cab</CabinetFileName>
    <EmbedCab>true</EmbedCab>
   </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="4.0.4" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="$(PublishOutputDir)">
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <ComponentGroupName>ProductComponents</ComponentGroupName>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressCom>true</SuppressCom>
      <SuppressRegistry>true</SuppressRegistry>
    </HarvestDirectory>
  </ItemGroup>

  <ItemGroup>
    <BindPath Include="$(PublishOutputDir)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MerlinManager\MerlinManager.csproj" />
  </ItemGroup>
</Project>
