<Window x:Class="MerlinManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:MerlinManager.Models"
        mc:Ignorable="d"
        Title="Merlin Manager"
        Height="660"
        Width="1000"
        MinWidth="1000"
        MinHeight="660" Icon="/favicon.ico">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding PictureSource}"
                       Width="24"
                       Height="24"
                       Margin="0,0,8,0" />
                <TextBlock VerticalAlignment="Center" Text="📂 " />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock VerticalAlignment="Center" Text="  (" Foreground="Gray" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Id}" Foreground="Gray" />
                <TextBlock VerticalAlignment="Center" Text=")" Foreground="Gray" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type models:ItemNode}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding PictureSource}"
                       Width="20"
                       Height="20"
                       Margin="0,0,8,0" />
                <TextBlock VerticalAlignment="Center" Text="🎵 " />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                <TextBlock VerticalAlignment="Center" Text="  (" Foreground="Gray" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Id}" Foreground="Gray" />
                <TextBlock VerticalAlignment="Center" Text=")" Foreground="Gray" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Background="Transparent">
            <MenuItem Header="Fichier">
                <MenuItem Header="🚀 Initialiser dossiers" Click="InitializeFoldersMenuItem_Click" />
                <MenuItem Header="📁 Dossier de stockage..." Click="SelectStorageFolderMenuItem_Click" />
                <Separator />
                <MenuItem Header="Quitter" Click="QuitMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Grid Margin="6 0" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                <Button Content="📂 Dossier" Width="122" Height="34" Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" Click="AddFolder_Click" />
                <Button Content="📂 Sous-dossier" Width="132" Height="34" Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" Click="AddSubfolder_Click" />
                <Button Content="🎵 Audio " Width="118" Height="34" Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" Click="AddItem_Click" />
                <Button x:Name="btnEdit" Content="✏️ Editer" Width="130" Height="34" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Click="EditSelected_Click" />
                <Button x:Name="btnMove" Content="🔀 Déplacer" Width="118" Height="34" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Click="MoveItem_Click" />
                <Button x:Name="btnDelete" Content="🗑️ Supprimer" Width="132" Height="34" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Click="DeleteSelected_Click" />
                <Button x:Name="btnSend" Content="🚀 Transférer" Width="132" Height="34" Margin="0,0,8,8" Style="{StaticResource AttentionButtonStyle}" Click="Send_Click" />
            </WrapPanel>

            <Border Grid.Row="2"
                Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,10,0">
                <TreeView x:Name="LibraryTreeView"
                      ItemsSource="{Binding Folders}"
                      SelectedItemChanged="LibraryTreeView_SelectedItemChanged" />
            </Border>

            <Border Grid.Row="2"
                Grid.Column="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
                <StackPanel>
                    <TextBlock Text="Sélection"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                    <TextBlock x:Name="SelectionTypeText" Text="Type: -" Margin="0,0,0,6" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="SelectionNameText" Text="Nom: -" Margin="0,0,0,6" />
                    <TextBlock x:Name="SelectionIdText" Text="ID: -" Margin="0,0,0,12" Foreground="{StaticResource TextMutedBrush}" />
                    <Border BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        Width="160"
                        Height="160"
                        CornerRadius="8"
                        Padding="8"
                        Background="#FAFCFF">
                        <Image x:Name="SelectionImage" Stretch="Uniform" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="VersionText" Grid.Row="2" Text="Merlin Manager - v0.0.0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,8,4,4" Foreground="{StaticResource TextMutedBrush}" />
    </Grid>
</Window>
