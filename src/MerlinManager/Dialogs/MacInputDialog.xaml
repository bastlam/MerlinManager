<Window x:Class="MerlinManager.Dialogs.MacInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adresse MAC du boîtier"
        Height="260"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="/favicon.ico">
    <Grid Margin="18">
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Adresse MAC WiFi du boîtier Merlin"
                           FontWeight="SemiBold" />
                <TextBox Grid.Row="1"
                         x:Name="MacTextBox"
                         Margin="0,8,0,0"
                         MinWidth="360" />
                <TextBlock Grid.Row="2"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Opacity="0.75"
                           Text="Format AA:BB:CC:DD:EE:FF. Visible dans l'application Merlin (infos du boîtier) ou dans les appareils connectés de votre box. Nécessaire pour (dé)chiffrer les playlists des versions récentes." />

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Height="24"
                            Margin="0,18,0,0">
                    <Button Content="Annuler"
                            Width="92"
                            IsCancel="True"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Valider"
                            Width="92"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OkButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
